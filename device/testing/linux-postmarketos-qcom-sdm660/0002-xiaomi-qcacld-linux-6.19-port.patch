index 0d507be22bb43bd41dbf3104f601a45de7f836b4..a371ceabb5bbc5ae46c7f8c50cd747b6288cff0b 100644
--- a/drivers/staging/qcacld-3.0/core/cds/inc/cds_crypto.h
+++ b/drivers/staging/qcacld-3.0/core/cds/inc/cds_crypto.h
@@ -26,17 +26,89 @@
  *
  */
 
-#include <linux/crypto.h>
+#include <crypto/skcipher.h>
+#include <linux/err.h>
+#include <linux/scatterlist.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#define crypto_cipher cds_crypto_cipher
+#define crypto_cipher_setkey cds_crypto_cipher_setkey
+#define crypto_cipher_encrypt_one cds_crypto_cipher_encrypt_one
+
+struct cds_crypto_cipher {
+	struct crypto_sync_skcipher *tfm;
+};
 
 static inline struct crypto_cipher *
 cds_crypto_alloc_cipher(const char *alg_name, u32 type, u32 mask)
 {
-	return crypto_alloc_cipher(alg_name, type, mask);
+	struct cds_crypto_cipher *cipher;
+	const char *name = !strcmp(alg_name, "aes") ? "ecb(aes)" : alg_name;
+
+	cipher = kmalloc(sizeof(*cipher), GFP_KERNEL);
+	if (!cipher)
+		return ERR_PTR(-ENOMEM);
+
+	cipher->tfm = crypto_alloc_sync_skcipher(name, type, mask);
+	if (IS_ERR(cipher->tfm)) {
+		int ret = PTR_ERR(cipher->tfm);
+
+		kfree(cipher);
+		return ERR_PTR(ret);
+	}
+
+	return cipher;
+}
+
+static inline int cds_crypto_cipher_setkey(struct crypto_cipher *tfm,
+					   const u8 *key, unsigned int len)
+{
+	return crypto_sync_skcipher_setkey(tfm->tfm, key, len);
+}
+
+static inline void
+cds_crypto_cipher_encrypt_one(struct crypto_cipher *tfm, u8 *dst,
+				      const u8 *src)
+{
+	SYNC_SKCIPHER_REQUEST_ON_STACK(req, tfm->tfm);
+	struct scatterlist sg;
+	unsigned int len = crypto_sync_skcipher_blocksize(tfm->tfm);
+	u8 *block;
+	int ret;
+
+	/*
+	 * skcipher scatterlists require linear-mapped memory.  QCACLD also
+	 * encrypts static module data, which is outside that mapping on arm64.
+	 * Use a linear bounce buffer for both source and destination.
+	 */
+	block = kmemdup(src, len, GFP_ATOMIC);
+	if (!block) {
+		memset(dst, 0, len);
+		return;
+	}
+
+	sg_init_one(&sg, block, len);
+	skcipher_request_set_sync_tfm(req, tfm->tfm);
+	skcipher_request_set_callback(req, 0, NULL, NULL);
+	skcipher_request_set_crypt(req, &sg, &sg, len, NULL);
+	ret = crypto_skcipher_encrypt(req);
+	if (ret)
+		memset(dst, 0, len);
+	else
+		memcpy(dst, block, len);
+	skcipher_request_zero(req);
+	memzero_explicit(block, len);
+	kfree(block);
 }
 
 static inline void cds_crypto_free_cipher(struct crypto_cipher *tfm)
 {
-	crypto_free_cipher(tfm);
+	if (IS_ERR_OR_NULL(tfm))
+		return;
+
+	crypto_free_sync_skcipher(tfm->tfm);
+	kfree(tfm);
 }
 
 #endif /* if !defined __CDS_CRYPTO_H */

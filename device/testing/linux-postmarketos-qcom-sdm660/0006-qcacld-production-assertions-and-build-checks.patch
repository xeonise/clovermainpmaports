# qcacld: safer production assertions, CE access and compiler checks
#
# Allocator debug support must not silently turn vendor assertions into
# BUG(). Check target availability before IRQ/tasklet CE MMIO, including
# the register write that disables a CE interrupt. Keep pointer-type
# errors fatal, fix read-only netdev MAC uses, and add void prototypes
# accepted by current clang. The adapter MAC tracks netdev dev_addr.
#
diff --git a/drivers/staging/qca-wifi-host-cmn/hif/src/ce/ce_service.c b/drivers/staging/qca-wifi-host-cmn/hif/src/ce/ce_service.c

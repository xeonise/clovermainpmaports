--- a/drivers/staging/qcacld-3.0/configs/default_defconfig
+++ b/drivers/staging/qcacld-3.0/configs/default_defconfig
@@ -351,16 +351,10 @@ BUILD_DEBUG_VERSION := y
 #Enable this flag to build driver in diag version
 BUILD_DIAG_VERSION := y
 
-ifeq ($(CONFIG_SLUB_DEBUG), y)
-	PANIC_ON_BUG := y
-	WLAN_WARN_ON_ASSERT := y
-else ifeq ($(CONFIG_PERF_DEBUG), y)
-	PANIC_ON_BUG := y
-	WLAN_WARN_ON_ASSERT := y
-else
-	PANIC_ON_BUG := n
-	WLAN_WARN_ON_ASSERT := n
-endif
+# SLUB_DEBUG only makes allocator diagnostics available; it must not turn
+# vendor assertions into BUG()s that kill a lock-owning driver thread.
+PANIC_ON_BUG := n
+WLAN_WARN_ON_ASSERT := n
 
 # Compile all log levels by default
 CONFIG_WLAN_LOG_FATAL := y

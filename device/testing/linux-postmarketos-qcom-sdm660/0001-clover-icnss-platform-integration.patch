+
+static const struct dev_pm_ops icnss_clover_pm_ops = {
+	.suspend = icnss_clover_pm_suspend,
+	.resume = icnss_clover_pm_resume,
+	.suspend_noirq = icnss_clover_pm_suspend_noirq,
+	.resume_noirq = icnss_clover_pm_resume_noirq,
+};
+
+static const struct of_device_id icnss_clover_of_match[] = {
+	{ .compatible = "qcom,wcn3990-wifi" },
+	{}
+};
+
+static struct platform_driver icnss_clover_driver = {
+	.probe = icnss_clover_probe,
+	.remove = icnss_clover_remove,
+	.shutdown = icnss_clover_shutdown,
+	.driver = {

diff --git a/drivers/staging/qcom_icnss_clover/icnss_clover.c b/drivers/staging/qcom_icnss_clover/icnss_clover.c
new file mode 100644
index 0000000000000000000000000000000000000000..a7c1a1e25383b309fc89004f523f04b3f1468233
--- /dev/null
+++ b/drivers/staging/qcom_icnss_clover/icnss_clover.c
@@ -0,0 +1,2031 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ICNSS/WLFW backend for the WCN3990 in Xiaomi Clover.
+ *
+ * The wire protocol is the upstream WLFW
+ * v01 schema used by ath10k_snoc on the same hardware.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/etherdevice.h>
+#include <linux/firmware.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iommu.h>
+#include <linux/irqdomain.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of_irq.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/qrtr.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+#include <linux/soc/qcom/qmi.h>
+#include <linux/firmware/qcom/qcom_scm.h>
+#include <net/sock.h>
+#include <soc/qcom/icnss.h>
+
+#include "wlan_firmware_service_v01.h"
+
+#define ICNSS_WLFW_CLIENT_ID		0x4b4e454c
+#define ICNSS_WLFW_TIMEOUT		30
+#define ICNSS_BDF_FILE			"ath10k/WCN3990/hw1.0/bdwlan.bin"
+#define ICNSS_MSA_SIZE			0x100000
+#define ICNSS_MAX_MEM_REGIONS		2
+#define ICNSS_MAX_UNSAFE_CHANNELS	64
+
+struct icnss_mem_region {
+	phys_addr_t addr;
+	u32 size;
+	bool secure;
+	enum {
+		ICNSS_MSA_OWNER_HLOS,
+		ICNSS_MSA_OWNER_WLAN,
+		ICNSS_MSA_OWNER_FIXED,
+	} owner;
+};
+
+enum icnss_recovery_state {
+	ICNSS_RECOVERY_INACTIVE,
+	ICNSS_RECOVERY_INITIALIZING,
+	ICNSS_RECOVERY_FW_READY,
+	ICNSS_RECOVERY_RECOVERING,
+	ICNSS_RECOVERY_READY,
+	ICNSS_RECOVERY_FAILED,
+};
+
+struct icnss_ce_irq {
+	int irq;
+	void *ctx;
+	bool requested;
+};
+
+struct icnss_clover {
+	struct device *dev;
+	struct mutex lock;
+	struct icnss_driver_ops *ops;
+
+	void __iomem *mem_base;
+	phys_addr_t mem_base_pa;
+	struct icnss_ce_irq ce[ICNSS_MAX_IRQ_REGISTRATIONS];
+
+	struct regulator_bulk_data vregs[5];
+	struct clk_bulk_data clks[2];
+	bool powered;
+
+	void *msa_va;
+	phys_addr_t msa_pa;
+	size_t msa_size;
+	struct icnss_mem_region mem_region[ICNSS_MAX_MEM_REGIONS];
+	u32 nr_mem_region;
+	bool msa_fixed_perm;
+	bool msa_layout_valid;
+	bool msa_adopted;
+
+	struct qmi_handle qmi;
+	struct sockaddr_qrtr sq;
+	struct workqueue_struct *wq;
+	struct work_struct server_work;
+	struct work_struct bdf_work;
+	struct work_struct fw_ready_work;
+	struct work_struct server_exit_work;
+	bool qmi_initialized;
+	bool qmi_connected;
+	bool removing;
+	bool fw_ready;
+	bool msa_ready;
+
+	struct icnss_driver_ops *active_ops;
+	bool driver_probed;
+	bool recovering;
+	enum icnss_recovery_state recovery_state;
+	u32 recovery_generation;
+	int last_error;
+
+	struct icnss_soc_info soc;
+	u8 mac_addr[ETH_ALEN];
+	u16 unsafe_channels[ICNSS_MAX_UNSAFE_CHANNELS];
+	u16 unsafe_channel_count;
+	void *dfs_nol;
+	u16 dfs_nol_len;
+};
+
+static DEFINE_MUTEX(icnss_global_lock);
+static struct icnss_clover *icnss_global;
+static atomic_t icnss_driver_load_count = ATOMIC_INIT(0);
+static enum cnss_cc_src icnss_cc_source = CNSS_SOURCE_CORE;
+
+static const char *icnss_recovery_state_name(enum icnss_recovery_state state)
+{
+	switch (state) {
+	case ICNSS_RECOVERY_INACTIVE:
+		return "inactive";
+	case ICNSS_RECOVERY_INITIALIZING:
+		return "initializing";
+	case ICNSS_RECOVERY_FW_READY:
+		return "firmware-ready";
+	case ICNSS_RECOVERY_RECOVERING:
+		return "recovering";
+	case ICNSS_RECOVERY_READY:
+		return "ready";
+	case ICNSS_RECOVERY_FAILED:
+		return "failed";
+	}
+
+	return "unknown";
+}
+
+static bool icnss_msa_wlan_owned(struct icnss_clover *ic)
+{
+	bool owned = false;
+	int i;
+
+	mutex_lock(&ic->lock);
+	for (i = 0; i < ic->nr_mem_region; i++)
+		owned |= ic->mem_region[i].owner == ICNSS_MSA_OWNER_WLAN;
+	mutex_unlock(&ic->lock);
+
+	return owned;
+}
+
+static void icnss_set_failed(struct icnss_clover *ic, int error)
+{
+	mutex_lock(&ic->lock);
+	ic->last_error = error;
+	ic->recovery_state = ICNSS_RECOVERY_FAILED;
+	mutex_unlock(&ic->lock);
+}
+
+static void icnss_begin_recovery_locked(struct icnss_clover *ic)
+{
+	if (ic->recovery_state != ICNSS_RECOVERY_RECOVERING)
+		ic->recovery_generation++;
+	ic->recovery_state = ICNSS_RECOVERY_RECOVERING;
+	ic->last_error = 0;
+}
+
+static const char * const icnss_vreg_names[] = {
+	"vdd-0.8-cx-mx",
+	"vdd-1.8-xo",
+	"vdd-1.3-rfa",
+	"vdd-3.3-ch0",
+	"vdd-3.3-ch1",
+};
+
+static const char * const icnss_clk_names[] = {
+	"cxo_ref_clk_pin",
+	"qdss",
+};
+
+static struct icnss_clover *icnss_from_dev(struct device *dev)
+{
+	struct icnss_clover *ic;
+
+	mutex_lock(&icnss_global_lock);
+	ic = icnss_global;
+	if (ic && dev && dev != ic->dev)
+		ic = NULL;
+	mutex_unlock(&icnss_global_lock);
+
+	return ic;
+}
+
+static int icnss_result_to_errno(const struct qmi_response_type_v01 *resp)
+{
+	if (resp->result == QMI_RESULT_SUCCESS_V01)
+		return 0;
+
+	return resp->error == QMI_ERR_NOT_SUPPORTED_V01 ?
+		-EOPNOTSUPP : -EREMOTEIO;
+}
+
+static int icnss_qmi_result(struct icnss_clover *ic, const char *operation,
+			    const struct qmi_response_type_v01 *resp)
+{
+	int ret = icnss_result_to_errno(resp);
+
+	if (ret)
+		dev_err(ic->dev,
+			"WLFW %s rejected: result=%u error=%u mapped=%d\n",
+			operation, resp->result, resp->error, ret);
+
+	return ret;
+}
+
+static int icnss_hw_power_on(struct icnss_clover *ic)
+{
+	int ret;
+
+	mutex_lock(&ic->lock);
+	if (ic->powered) {
+		mutex_unlock(&ic->lock);
+		return 0;
+	}
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ic->vregs), ic->vregs);
+	if (ret)
+		goto out;
+
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(ic->clks), ic->clks);
+	if (ret) {
+		regulator_bulk_disable(ARRAY_SIZE(ic->vregs), ic->vregs);
+		goto out;
+	}
+
+	ic->powered = true;
+out:
+	mutex_unlock(&ic->lock);
+	return ret;
+}
+
+static int icnss_hw_power_off(struct icnss_clover *ic)
+{
+	int ret = 0;
+
+	mutex_lock(&ic->lock);
+	if (!ic->powered)
+		goto out;
+
+	clk_bulk_disable_unprepare(ARRAY_SIZE(ic->clks), ic->clks);
+	ret = regulator_bulk_disable(ARRAY_SIZE(ic->vregs), ic->vregs);
+	ic->powered = false;
+out:
+	mutex_unlock(&ic->lock);
+	return ret;
+}
+
+static int icnss_assign_one_region(struct icnss_clover *ic,
+				   struct icnss_mem_region *region)
+{
+	struct qcom_scm_vmperm dst[3];
+	u64 src = BIT(QCOM_SCM_VMID_HLOS);
+	unsigned int count = 2;
+	int ret;
+
+	dst[0].vmid = QCOM_SCM_VMID_MSS_MSA;
+	dst[0].perm = QCOM_SCM_PERM_RW;
+	dst[1].vmid = QCOM_SCM_VMID_WLAN;
+	dst[1].perm = QCOM_SCM_PERM_RW;
+	if (!region->secure) {
+		dst[2].vmid = QCOM_SCM_VMID_WLAN_CE;
+		dst[2].perm = QCOM_SCM_PERM_RW;
+		count = 3;
+	}
+
+	ret = qcom_scm_assign_mem(region->addr, region->size, &src, dst, count);
+	if (ret)
+		dev_err(ic->dev, "failed to assign MSA region: %d\n", ret);
+	return ret;
+}
+
+static int icnss_unassign_one_region(struct icnss_clover *ic,
+				     struct icnss_mem_region *region)
+{
+	struct qcom_scm_vmperm dst = {
+		.vmid = QCOM_SCM_VMID_HLOS,
+		.perm = QCOM_SCM_PERM_RW,
+	};
+	u64 src = BIT(QCOM_SCM_VMID_MSS_MSA) | BIT(QCOM_SCM_VMID_WLAN);
+
+	if (!region->secure)
+		src |= BIT(QCOM_SCM_VMID_WLAN_CE);
+
+	return qcom_scm_assign_mem(region->addr, region->size, &src, &dst, 1);
+}
+
+static int icnss_assign_msa(struct icnss_clover *ic)
+{
+	bool newly_assigned[ICNSS_MAX_MEM_REGIONS] = {};
+	bool wlan_owned;
+	int assign_error;
+	int i;
+	int ret;
+
+	if (ic->msa_fixed_perm)
+		return 0;
+
+	for (i = 0; i < ic->nr_mem_region; i++) {
+		mutex_lock(&ic->lock);
+		wlan_owned = ic->mem_region[i].owner == ICNSS_MSA_OWNER_WLAN;
+		mutex_unlock(&ic->lock);
+		if (wlan_owned)
+			continue;
+		ret = icnss_assign_one_region(ic, &ic->mem_region[i]);
+		if (ret)
+			goto unwind;
+		mutex_lock(&ic->lock);
+		ic->mem_region[i].owner = ICNSS_MSA_OWNER_WLAN;
+		mutex_unlock(&ic->lock);
+		newly_assigned[i] = true;
+	}
+	return 0;
+
+unwind:
+	assign_error = ret;
+	while (--i >= 0) {
+		if (!newly_assigned[i])
+			continue;
+		if (!icnss_unassign_one_region(ic, &ic->mem_region[i])) {
+			mutex_lock(&ic->lock);
+			ic->mem_region[i].owner = ICNSS_MSA_OWNER_HLOS;
+			mutex_unlock(&ic->lock);
+		}
+	}
+	return assign_error;
+}
+
+static int icnss_unassign_msa(struct icnss_clover *ic)
+{
+	int first_error = 0;
+	int i;
+	int ret;
+
+	if (ic->msa_fixed_perm)
+		return 0;
+
+	for (i = 0; i < ic->nr_mem_region; i++) {
+		mutex_lock(&ic->lock);
+		ret = ic->mem_region[i].owner == ICNSS_MSA_OWNER_WLAN;
+		mutex_unlock(&ic->lock);
+		if (!ret)
+			continue;
+		ret = icnss_unassign_one_region(ic, &ic->mem_region[i]);
+		if (ret) {
+			if (!first_error)
+				first_error = ret;
+			dev_err(ic->dev,
+				"failed to return MSA region %d to HLOS: %d\n",
+				i, ret);
+			continue;
+		}
+		mutex_lock(&ic->lock);
+		ic->mem_region[i].owner = ICNSS_MSA_OWNER_HLOS;
+		mutex_unlock(&ic->lock);
+	}
+
+	return first_error;
+}
+
+static int icnss_qmi_ind_register(struct icnss_clover *ic)
+{
+	struct wlfw_ind_register_resp_msg_v01 resp = {};
+	struct wlfw_ind_register_req_msg_v01 req = {};
+	struct qmi_txn txn;
+	int ret;
+
+	req.client_id_valid = 1;
+	req.client_id = ICNSS_WLFW_CLIENT_ID;
+	req.fw_ready_enable_valid = 1;
+	req.fw_ready_enable = 1;
+	req.msa_ready_enable_valid = 1;
+	req.msa_ready_enable = 1;
+
+	ret = qmi_txn_init(&ic->qmi, &txn,
+			   wlfw_ind_register_resp_msg_v01_ei, &resp);
+	if (ret < 0)
+		return ret;
+	ret = qmi_send_request(&ic->qmi, NULL, &txn,
+			       QMI_WLFW_IND_REGISTER_REQ_V01,
+			       WLFW_IND_REGISTER_REQ_MSG_V01_MAX_MSG_LEN,
+			       wlfw_ind_register_req_msg_v01_ei, &req);
+	if (ret) {
+		qmi_txn_cancel(&txn);
+		return ret;
+	}
+	ret = qmi_txn_wait(&txn, ICNSS_WLFW_TIMEOUT * HZ);
+	if (ret < 0)
+		return ret;
+	ret = icnss_qmi_result(ic, "ind-register", &resp.resp);
+	if (!ret)
+		dev_info(ic->dev,
+			 "WLFW ind-register status: valid=%u status=0x%llx\n",
+			 resp.fw_status_valid, resp.fw_status);
+	if (!ret && resp.fw_status_valid) {
+		mutex_lock(&ic->lock);
+		if (resp.fw_status & QMI_WLFW_FW_READY_V01)
+			ic->fw_ready = true;
+		if (resp.fw_status & QMI_WLFW_MSA_READY_V01)
+			ic->msa_ready = true;
+		if ((resp.fw_status & (QMI_WLFW_ALREADY_REGISTERED_V01 |
+				       QMI_WLFW_FW_READY_V01)) &&
+		    !ic->msa_fixed_perm && !ic->msa_layout_valid)
+			ic->msa_adopted = true;
+		mutex_unlock(&ic->lock);
+	}
+	return ret;
+}
+
+static int icnss_qmi_host_cap(struct icnss_clover *ic)
+{
+	struct wlfw_host_cap_resp_msg_v01 resp = {};
+	struct wlfw_host_cap_req_msg_v01 req = {};
+	const struct qmi_elem_info *req_ei;
+	struct qmi_txn txn;
+	int ret;
+
+	req.daemon_support_valid = 1;
+	req.daemon_support = 0;
+	req_ei = device_property_read_bool(ic->dev,
+					   "qcom,snoc-host-cap-8bit-quirk") ?
+		wlfw_host_cap_8bit_req_msg_v01_ei :
+		wlfw_host_cap_req_msg_v01_ei;
+
+	ret = qmi_txn_init(&ic->qmi, &txn,
+			   wlfw_host_cap_resp_msg_v01_ei, &resp);
+	if (ret < 0)
+		return ret;
+	ret = qmi_send_request(&ic->qmi, NULL, &txn,
+			       QMI_WLFW_HOST_CAP_REQ_V01,
+			       WLFW_HOST_CAP_REQ_MSG_V01_MAX_MSG_LEN,
+			       req_ei, &req);
+	if (ret) {
+		qmi_txn_cancel(&txn);
+		return ret;
+	}
+	ret = qmi_txn_wait(&txn, ICNSS_WLFW_TIMEOUT * HZ);
+	if (ret < 0)
+		return ret;
+	ret = icnss_qmi_result(ic, "host-cap", &resp.resp);
+	return ret == -EOPNOTSUPP ? 0 : ret;
+}
+
+static int icnss_qmi_msa_info(struct icnss_clover *ic)
+{
+	struct wlfw_msa_info_resp_msg_v01 resp = {};
+	struct wlfw_msa_info_req_msg_v01 req = {};
+	struct icnss_mem_region region[ICNSS_MAX_MEM_REGIONS] = {};
+	phys_addr_t end = ic->msa_pa + ic->msa_size;
+	struct qmi_txn txn;
+	bool reclaim_adopted = false;
+	bool retained = false;
+	int i;
+	int ret;
+
+	req.msa_addr = ic->msa_pa;
+	req.size = ic->msa_size;
+	ret = qmi_txn_init(&ic->qmi, &txn,
+			   wlfw_msa_info_resp_msg_v01_ei, &resp);
+	if (ret < 0)
+		return ret;
+	ret = qmi_send_request(&ic->qmi, NULL, &txn,
+			       QMI_WLFW_MSA_INFO_REQ_V01,
+			       WLFW_MSA_INFO_REQ_MSG_V01_MAX_MSG_LEN,
+			       wlfw_msa_info_req_msg_v01_ei, &req);
+	if (ret) {
+		qmi_txn_cancel(&txn);
+		return ret;
+	}
+	ret = qmi_txn_wait(&txn, ICNSS_WLFW_TIMEOUT * HZ);
+	if (ret < 0)
+		return ret;
+	ret = icnss_qmi_result(ic, "msa-info", &resp.resp);
+	if (ret == -EREMOTEIO &&
+	    resp.resp.error == QMI_ERR_INCOMPATIBLE_STATE_V01) {
+		mutex_lock(&ic->lock);
+		retained = ic->msa_adopted;
+		mutex_unlock(&ic->lock);
+		if (retained)
+			return -EALREADY;
+	}
+	if (ret)
+		return ret;
+	if (resp.mem_region_info_len > ICNSS_MAX_MEM_REGIONS)
+		return -EOVERFLOW;
+
+	for (i = 0; i < resp.mem_region_info_len; i++) {
+		u64 addr = resp.mem_region_info[i].region_addr;
+		u32 size = resp.mem_region_info[i].size;
+
+		if (addr < ic->msa_pa || addr > end || size > ic->msa_size ||
+		    addr + size < addr || addr + size > end)
+			return -ERANGE;
+		region[i].addr = addr;
+		region[i].size = size;
+		region[i].secure = resp.mem_region_info[i].secure_flag;
+		region[i].owner = ic->msa_fixed_perm ?
+			ICNSS_MSA_OWNER_FIXED : ICNSS_MSA_OWNER_HLOS;
+	}
+
+	mutex_lock(&ic->lock);
+	if (ic->msa_layout_valid) {
+		for (i = 0; i < ic->nr_mem_region; i++)
+			retained |= ic->mem_region[i].owner ==
+				ICNSS_MSA_OWNER_WLAN;
+		if (retained && ic->nr_mem_region != resp.mem_region_info_len) {
+			mutex_unlock(&ic->lock);
+			dev_err(ic->dev,
+				"WLFW changed retained MSA layout during recovery\n");
+			return -ESTALE;
+		}
+		for (i = 0; retained && i < ic->nr_mem_region; i++) {
+			if (ic->mem_region[i].addr != region[i].addr ||
+			    ic->mem_region[i].size != region[i].size ||
+			    ic->mem_region[i].secure != region[i].secure) {
+				mutex_unlock(&ic->lock);
+				dev_err(ic->dev,
+					"WLFW changed retained MSA region %d\n", i);
+				return -ESTALE;
+			}
+		}
+		if (retained) {
+			mutex_unlock(&ic->lock);
+			return 0;
+		}
+	}
+
+	if (ic->msa_adopted) {
+		for (i = 0; i < resp.mem_region_info_len; i++)
+			region[i].owner = ICNSS_MSA_OWNER_WLAN;
+		ic->msa_adopted = false;
+		reclaim_adopted = !ic->msa_fixed_perm;
+		dev_info(ic->dev,
+			 "materialized inherited WLAN MSA layout after recovery\n");
+	}
+	ic->nr_mem_region = resp.mem_region_info_len;
+	memcpy(ic->mem_region, region,
+	       ic->nr_mem_region * sizeof(ic->mem_region[0]));
+	ic->msa_layout_valid = true;
+	mutex_unlock(&ic->lock);
+
+	/*
+	 * ALREADY_REGISTERED does not include the firmware's MSA layout, so an
+	 * adopted session cannot safely change SCM ownership until a subsequent
+	 * WLFW restart returns that layout.  Ownership survives the remoteproc
+	 * restart, however.  Return only these validated regions to HLOS now; the
+	 * normal initialization path below will assign them to the new session.
+	 */
+	if (reclaim_adopted) {
+		for (i = 0; i < resp.mem_region_info_len; i++) {
+			ret = icnss_unassign_one_region(ic, &ic->mem_region[i]);
+			if (ret && ret != -EINVAL) {
+				dev_err(ic->dev,
+					"failed to reclaim inherited MSA region %d: %d\n",
+					i, ret);
+				return ret;
+			}
+			if (ret == -EINVAL)
+				dev_info(ic->dev,
+					 "inherited MSA region %d was already HLOS-owned\n",
+					 i);
+			mutex_lock(&ic->lock);
+			ic->mem_region[i].owner = ICNSS_MSA_OWNER_HLOS;
+			mutex_unlock(&ic->lock);
+		}
+		dev_info(ic->dev,
+			 "reclaimed inherited WLAN MSA layout for reinitialization\n");
+	}
+	return 0;
+}
+
+static int icnss_qmi_msa_ready(struct icnss_clover *ic)
+{
+	struct wlfw_msa_ready_resp_msg_v01 resp = {};
+	struct wlfw_msa_ready_req_msg_v01 req = {};
+	struct qmi_txn txn;
+	int ret;
+
+	ret = qmi_txn_init(&ic->qmi, &txn,
+			   wlfw_msa_ready_resp_msg_v01_ei, &resp);
+	if (ret < 0)
+		return ret;
+	ret = qmi_send_request(&ic->qmi, NULL, &txn,
+			       QMI_WLFW_MSA_READY_REQ_V01,
+			       WLFW_MSA_READY_REQ_MSG_V01_MAX_MSG_LEN,
+			       wlfw_msa_ready_req_msg_v01_ei, &req);
+	if (ret) {
+		qmi_txn_cancel(&txn);
+		return ret;
+	}
+	ret = qmi_txn_wait(&txn, ICNSS_WLFW_TIMEOUT * HZ);
+	return ret < 0 ? ret :
+		icnss_qmi_result(ic, "msa-ready", &resp.resp);
+}
+
+static int icnss_qmi_cap(struct icnss_clover *ic)
+{
+	struct wlfw_cap_resp_msg_v01 *resp;
+	struct wlfw_cap_req_msg_v01 req = {};
+	struct qmi_txn txn;
+	bool adopted;
+	int ret;
+
+	resp = kzalloc(sizeof(*resp), GFP_KERNEL);
+	if (!resp)
+		return -ENOMEM;
+	ret = qmi_txn_init(&ic->qmi, &txn, wlfw_cap_resp_msg_v01_ei, resp);
+	if (ret < 0)
+		goto out;
+	ret = qmi_send_request(&ic->qmi, NULL, &txn, QMI_WLFW_CAP_REQ_V01,
+			       WLFW_CAP_REQ_MSG_V01_MAX_MSG_LEN,
+			       wlfw_cap_req_msg_v01_ei, &req);
+	if (ret) {
+		qmi_txn_cancel(&txn);
+		goto out;
+	}
+	ret = qmi_txn_wait(&txn, ICNSS_WLFW_TIMEOUT * HZ);
+	if (ret < 0)
+		goto out;
+	ret = icnss_qmi_result(ic, "cap", &resp->resp);
+	if (ret == -EREMOTEIO &&
+	    resp->resp.error == QMI_ERR_INCOMPATIBLE_STATE_V01) {
+		mutex_lock(&ic->lock);
+		adopted = ic->msa_adopted;
+		mutex_unlock(&ic->lock);
+		if (adopted)
+			ret = -EALREADY;
+	}
+	if (ret)
+		goto out;
+
+	if (resp->chip_info_valid) {
+		ic->soc.chip_id = resp->chip_info.chip_id;
+		ic->soc.chip_family = resp->chip_info.chip_family;
+	}
+	if (resp->board_info_valid)
+		ic->soc.board_id = resp->board_info.board_id;
+	if (resp->soc_info_valid)
+		ic->soc.soc_id = resp->soc_info.soc_id;
+	if (resp->fw_version_info_valid) {
+		ic->soc.fw_version = resp->fw_version_info.fw_version;
+		strscpy(ic->soc.fw_build_timestamp,
+			resp->fw_version_info.fw_build_timestamp,
+			sizeof(ic->soc.fw_build_timestamp));
+	}
+out:
+	kfree(resp);
+	return ret;
+}
+
+static int icnss_qmi_bdf_download(struct icnss_clover *ic,
+				  const struct firmware *fw)
+{
+	struct wlfw_bdf_download_resp_msg_v01 resp = {};
+	struct wlfw_bdf_download_req_msg_v01 *req;
+	const u8 *data = fw->data;
+	size_t remaining = fw->size;
+	struct qmi_txn txn;
+	int ret = 0;
+
+	if (!fw->size || fw->size > U32_MAX)
+		return -EFBIG;
+	req = kzalloc(sizeof(*req), GFP_KERNEL);
+	if (!req)
+		return -ENOMEM;
+
+	while (remaining) {
+		req->valid = 1;
+		req->file_id_valid = 1;
+		req->file_id = 0;
+		req->total_size_valid = 1;
+		req->total_size = fw->size;
+		req->seg_id_valid = 1;
+		req->data_valid = 1;
+		req->data_len = min_t(size_t, remaining,
+				      QMI_WLFW_MAX_DATA_SIZE_V01);
+		req->end_valid = 1;
+		req->end = remaining == req->data_len;
+		memcpy(req->data, data, req->data_len);
+
+		ret = qmi_txn_init(&ic->qmi, &txn,
+				   wlfw_bdf_download_resp_msg_v01_ei, &resp);
+		if (ret < 0)
+			break;
+		ret = qmi_send_request(&ic->qmi, NULL, &txn,
+				       QMI_WLFW_BDF_DOWNLOAD_REQ_V01,
+				       WLFW_BDF_DOWNLOAD_REQ_MSG_V01_MAX_MSG_LEN,
+				       wlfw_bdf_download_req_msg_v01_ei, req);
+		if (ret) {
+			qmi_txn_cancel(&txn);
+			break;
+		}
+		ret = qmi_txn_wait(&txn, ICNSS_WLFW_TIMEOUT * HZ);
+		if (ret < 0)
+			break;
+		ret = icnss_qmi_result(ic, "bdf-download", &resp.resp);
+		/* Released WCN3990 BDFs can fail only the final CRC check. */
+		if (ret && !(req->end &&
+			     resp.resp.error == QMI_ERR_MALFORMED_MSG_V01))
+			break;
+		ret = 0;
+		remaining -= req->data_len;
+		data += req->data_len;
+		req->seg_id++;
+	}
+	kfree(req);
+	return ret;
+}
+
+static int icnss_qmi_cal_report(struct icnss_clover *ic)
+{
+	struct wlfw_cal_report_resp_msg_v01 resp = {};
+	struct wlfw_cal_report_req_msg_v01 req = {};
+	struct qmi_txn txn;
+	int ret;
+
+	ret = qmi_txn_init(&ic->qmi, &txn,
+			   wlfw_cal_report_resp_msg_v01_ei, &resp);
+	if (ret < 0)
+		return ret;
+	ret = qmi_send_request(&ic->qmi, NULL, &txn,
+			       QMI_WLFW_CAL_REPORT_REQ_V01,
+			       WLFW_CAL_REPORT_REQ_MSG_V01_MAX_MSG_LEN,
+			       wlfw_cal_report_req_msg_v01_ei, &req);
+	if (ret) {
+		qmi_txn_cancel(&txn);
+		return ret;
+	}
+	ret = qmi_txn_wait(&txn, ICNSS_WLFW_TIMEOUT * HZ);
+	return ret < 0 ? ret :
+		icnss_qmi_result(ic, "cal-report", &resp.resp);
+}
+
+static void icnss_bdf_work(struct work_struct *work)
+{
+	struct icnss_clover *ic =
+		container_of(work, struct icnss_clover, bdf_work);
+	const struct firmware *fw;
+	int ret;
+
+	ret = request_firmware(&fw, ICNSS_BDF_FILE, ic->dev);
+	if (ret) {
+		dev_err(ic->dev, "failed to load %s: %d\n", ICNSS_BDF_FILE, ret);
+		goto failed;
+	}
+	ret = icnss_qmi_bdf_download(ic, fw);
+	release_firmware(fw);
+	if (ret)
+		goto failed;
+	ret = icnss_qmi_cal_report(ic);
+	if (ret)
+		goto failed;
+	dev_info(ic->dev, "WLFW board data and calibration report completed\n");
+	return;
+
+failed:
+	icnss_hw_power_off(ic);
+	icnss_set_failed(ic, ret);
+}

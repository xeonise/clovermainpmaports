+int icnss_get_wlan_unsafe_channel(u16 *list, u16 *count, u16 buf_len)
+{
+	struct icnss_clover *ic = icnss_from_dev(NULL);
+	size_t bytes;
+
+	if (!ic || !list || !count)
+		return -EINVAL;
+	mutex_lock(&ic->lock);
+	bytes = ic->unsafe_channel_count * sizeof(*list);
+	if (buf_len < bytes) {
+		mutex_unlock(&ic->lock);
+		return -ENOSPC;
+	}
+	memcpy(list, ic->unsafe_channels, bytes);
+	*count = ic->unsafe_channel_count;
+	mutex_unlock(&ic->lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(icnss_get_wlan_unsafe_channel);

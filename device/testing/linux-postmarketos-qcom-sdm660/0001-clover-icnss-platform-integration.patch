+int icnss_wlan_enable(struct device *dev, struct icnss_wlan_enable_cfg *cfg,
+		      enum icnss_driver_mode mode, const char *host_version)
+{
+	struct icnss_clover *ic = icnss_from_dev(dev);
+	enum wlfw_driver_mode_enum_v01 qmi_mode;
+	bool adopted;
+	int ret;
+
+	if (!ic)
+		return -ENODEV;
+	switch (mode) {
+	case ICNSS_MISSION: qmi_mode = QMI_WLFW_MISSION_V01; break;
+	case ICNSS_FTM: qmi_mode = QMI_WLFW_FTM_V01; break;
+	case ICNSS_EPPING: qmi_mode = QMI_WLFW_EPPING_V01; break;
+	case ICNSS_WALTEST: qmi_mode = QMI_WLFW_WALTEST_V01; break;
+	case ICNSS_OFF: qmi_mode = QMI_WLFW_OFF_V01; break;
+	case ICNSS_CCPM: qmi_mode = QMI_WLFW_CCPM_V01; break;
+	case ICNSS_QVIT: qmi_mode = QMI_WLFW_QVIT_V01; break;
+	default: return -EINVAL;
+	}
+	mutex_lock(&ic->lock);
+	ret = ic->qmi_connected && ic->fw_ready ? 0 : -ENETDOWN;
+	adopted = ic->msa_adopted;
+	mutex_unlock(&ic->lock);
+	if (ret)
+		return ret;
+	if (adopted) {
+		dev_info(ic->dev,
+			 "stopping inherited WLAN mode before reconfiguration\n");
+		ret = icnss_qmi_mode(ic, QMI_WLFW_OFF_V01);
+		if (ret)
+			return ret;
+	}
+	ret = icnss_qmi_cfg(ic, cfg, host_version);
+	return ret ? ret : icnss_qmi_mode(ic, qmi_mode);
+}
+EXPORT_SYMBOL_GPL(icnss_wlan_enable);
+
+int icnss_wlan_disable(struct device *dev, enum icnss_driver_mode mode)
+{
+	struct icnss_clover *ic = icnss_from_dev(dev);

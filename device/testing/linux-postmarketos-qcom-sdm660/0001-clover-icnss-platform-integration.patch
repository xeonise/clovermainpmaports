+int icnss_set_wlan_unsafe_channel(u16 *list, u16 count)
+{
+	struct icnss_clover *ic = icnss_from_dev(NULL);
+
+	if (!ic || (count && !list) || count > ICNSS_MAX_UNSAFE_CHANNELS)
+		return -EINVAL;
+	mutex_lock(&ic->lock);
+	memcpy(ic->unsafe_channels, list, count * sizeof(*list));
+	ic->unsafe_channel_count = count;
+	mutex_unlock(&ic->lock);
+	return 0;
+}

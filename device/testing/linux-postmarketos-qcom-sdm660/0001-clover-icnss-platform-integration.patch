+static void icnss_call_fw_ready(struct icnss_clover *ic)
+{
+	struct icnss_uevent_data event = {
+		.uevent = ICNSS_UEVENT_FW_READY,
+	};
+	struct icnss_driver_ops *ops;
+	bool reinit;
+	int ret = 0;
+
+	mutex_lock(&ic->lock);
+	if (ic->removing || !ic->qmi_connected) {
+		mutex_unlock(&ic->lock);
+		return;
+	}
+	ic->fw_ready = true;
+	ops = ic->ops;
+	reinit = ic->recovering && ic->driver_probed;
+	if (!ops) {
+		ic->recovery_state = ICNSS_RECOVERY_FW_READY;
+		ic->last_error = 0;
+	}
+	mutex_unlock(&ic->lock);
+
+	if (!ops)
+		return;
+	if (reinit && ops->shutdown)
+		ops->shutdown(ic->dev);
+	ret = icnss_hw_power_on(ic);
+	if (ret)
+		goto failed;
+	if (reinit && ops->reinit)
+		ret = ops->reinit(ic->dev);
+	else if (reinit)
+		ret = -EOPNOTSUPP;
+	else if (!ic->driver_probed)
+		ret = ops->probe(ic->dev);
+	if (!ret) {
+		mutex_lock(&ic->lock);
+		ic->active_ops = ops;
+		ic->driver_probed = true;
+		ic->recovering = false;
+		ic->recovery_state = ICNSS_RECOVERY_READY;
+		ic->last_error = 0;
+		mutex_unlock(&ic->lock);
+		if (ops->uevent)
+			ops->uevent(ic->dev, &event);
+		return;
+	}
+	icnss_hw_power_off(ic);
+failed:
+	icnss_set_failed(ic, ret);
+	dev_err(ic->dev, "qcacld ready callback failed: %d\n", ret);
+}
+
+static void icnss_fw_ready_work(struct work_struct *work)
+{
+	struct icnss_clover *ic =
+		container_of(work, struct icnss_clover, fw_ready_work);
+
+	icnss_call_fw_ready(ic);
+}
+
+static void icnss_server_exit_work(struct work_struct *work)
+{
+	struct icnss_clover *ic =
+		container_of(work, struct icnss_clover, server_exit_work);
+	struct icnss_uevent_fw_down_data down = { .crashed = true };
+	struct icnss_uevent_data event = {
+		.uevent = ICNSS_UEVENT_FW_DOWN,
+		.data = &down,
+	};
+	struct icnss_driver_ops *ops;
+
+	mutex_lock(&ic->lock);
+	dev_info(ic->dev,
+		 "WLFW service exit work in state %s (connected=%u)\n",
+		 icnss_recovery_state_name(ic->recovery_state),
+		 ic->qmi_connected);
+	ic->qmi_connected = false;
+	ic->fw_ready = false;
+	ic->msa_ready = false;
+	ops = ic->active_ops;
+	if (ic->driver_probed) {
+		ic->recovering = true;
+		icnss_begin_recovery_locked(ic);
+	} else {
+		ic->recovery_state = ICNSS_RECOVERY_INACTIVE;
+	}
+	mutex_unlock(&ic->lock);
+	if (ops && ops->uevent)
+		ops->uevent(ic->dev, &event);
+}
+
+static void icnss_server_work(struct work_struct *work)
+{
+	struct icnss_clover *ic =
+		container_of(work, struct icnss_clover, server_work);
+	const char *stage = "ind-register";
+	bool assigned_here;
+	bool msa_ready = false;
+	bool ready;
+	int ret;
+
+	ret = icnss_qmi_ind_register(ic);
+	if (ret)
+		goto fail_power;
+	mutex_lock(&ic->lock);
+	ready = ic->fw_ready;
+	mutex_unlock(&ic->lock);
+	if (ready) {
+		dev_info(ic->dev, "adopting already-ready WLFW state\n");
+		stage = "cap";
+		ret = icnss_qmi_cap(ic);
+		if (ret && ret != -EALREADY)
+			goto fail_power;
+		if (ret == -EALREADY)
+			dev_info(ic->dev,
+				 "adopting already-complete WLFW capability state\n");
+		goto firmware_ready;
+	}
+	stage = "host-cap";
+	ret = icnss_qmi_host_cap(ic);
+	if (ret)
+		goto fail_power;
+	stage = "msa-info";
+	ret = icnss_qmi_msa_info(ic);
+	if (ret == -EALREADY) {
+		dev_info(ic->dev,
+			 "adopting already-registered WLFW MSA state\n");
+		stage = "cap";
+		ret = icnss_qmi_cap(ic);
+		if (ret && ret != -EALREADY)
+			goto fail_power;
+		if (ret == -EALREADY)
+			dev_info(ic->dev,
+				 "adopting already-complete WLFW capability state\n");
+		mutex_lock(&ic->lock);
+		ic->fw_ready = true;
+		ready = true;
+		mutex_unlock(&ic->lock);
+		goto firmware_ready;
+	}
+	if (ret)
+		goto fail_power;
+	msleep(20);
+	assigned_here = !icnss_msa_wlan_owned(ic) && !ic->msa_fixed_perm;
+	stage = "msa-assign";
+	ret = icnss_assign_msa(ic);
+	if (ret)
+		goto fail_power;
+	stage = "msa-ready";
+	ret = icnss_qmi_msa_ready(ic);
+	if (ret)
+		goto fail_msa;
+	stage = "cap";
+	ret = icnss_qmi_cap(ic);
+	if (ret)
+		goto fail_msa;
+	mutex_lock(&ic->lock);
+	ready = ic->fw_ready;
+	mutex_unlock(&ic->lock);
+	if (!ready && device_property_read_bool(ic->dev,
+					       "qcom,no-msa-ready-indicator")) {
+		/*
+		 * Clover firmware does not raise MSA_READY as an indication.
+		 * Match ath10k_snoc and start BDF delivery immediately after CAP;
+		 * a second indication registration here changes the old firmware's
+		 * initialization sequence.
+		 */
+		queue_work(ic->wq, &ic->bdf_work);
+		return;
+	}
+	if (!ready) {
+		/*
+		 * FW_READY can be raised while server_work is still processing
+		 * MSA/CAP setup.  Re-registering indications also returns the
+		 * latched firmware status, closing that one-shot indication race.
+		 */
+		stage = "ready-status";
+		ret = icnss_qmi_ind_register(ic);
+		if (ret)
+			goto fail_msa;
+		mutex_lock(&ic->lock);
+		ready = ic->fw_ready;
+		msa_ready = ic->msa_ready;
+		mutex_unlock(&ic->lock);
+	}
+firmware_ready:
+	/* WLFW still needs the powered hardware to raise FW_READY. */
+	if (!ready) {
+		if (msa_ready)
+			queue_work(ic->wq, &ic->bdf_work);
+		return;
+	}
+	icnss_hw_power_off(ic);
+	if (ready) {
+		/* Publish protocol readiness before deferred qcacld callbacks. */
+		mutex_lock(&ic->lock);
+		dev_info(ic->dev,
+			 "publishing WLFW ready from state %s (connected=%u)\n",
+			 icnss_recovery_state_name(ic->recovery_state),
+			 ic->qmi_connected);
+		ic->recovery_state = ICNSS_RECOVERY_FW_READY;
+		ic->last_error = 0;
+		mutex_unlock(&ic->lock);
+		queue_work(ic->wq, &ic->fw_ready_work);
+	}
+	return;
+
+fail_msa:
+	if (assigned_here)
+		icnss_unassign_msa(ic);
+fail_power:
+	icnss_hw_power_off(ic);
+fail:
+	icnss_set_failed(ic, ret);
+	dev_err(ic->dev, "WLFW initialization failed at %s: %d\n",
+		stage, ret);
+}
+
+static void icnss_qmi_fw_ready_ind(struct qmi_handle *qmi,
+				   struct sockaddr_qrtr *sq,
+				   struct qmi_txn *txn, const void *data)
+{
+	struct icnss_clover *ic =
+		container_of(qmi, struct icnss_clover, qmi);
+
+	queue_work(ic->wq, &ic->fw_ready_work);
+}
+
+static void icnss_qmi_msa_ready_ind(struct qmi_handle *qmi,
+				    struct sockaddr_qrtr *sq,
+				    struct qmi_txn *txn, const void *data)
+{
+	struct icnss_clover *ic =
+		container_of(qmi, struct icnss_clover, qmi);
+
+	mutex_lock(&ic->lock);
+	ic->msa_ready = true;
+	mutex_unlock(&ic->lock);
+	queue_work(ic->wq, &ic->bdf_work);
+}
+
+static const struct qmi_msg_handler icnss_qmi_handlers[] = {
+	{
+		.type = QMI_INDICATION,
+		.msg_id = QMI_WLFW_MSA_READY_IND_V01,
+		.ei = wlfw_msa_ready_ind_msg_v01_ei,
+		.decoded_size = sizeof(struct wlfw_msa_ready_ind_msg_v01),
+		.fn = icnss_qmi_msa_ready_ind,
+	},
+	{
+		.type = QMI_INDICATION,
+		.msg_id = QMI_WLFW_FW_READY_IND_V01,
+		.ei = wlfw_fw_ready_ind_msg_v01_ei,
+		.decoded_size = sizeof(struct wlfw_fw_ready_ind_msg_v01),
+		.fn = icnss_qmi_fw_ready_ind,
+	},
+	{}
+};
+
+static int icnss_qmi_new_server(struct qmi_handle *qmi,
+				struct qmi_service *service)
+{
+	struct icnss_clover *ic =
+		container_of(qmi, struct icnss_clover, qmi);
+	int ret;
+
+	ic->sq.sq_family = AF_QIPCRTR;
+	ic->sq.sq_node = service->node;
+	ic->sq.sq_port = service->port;
+	ret = kernel_connect(qmi->sock, (struct sockaddr_unsized *)&ic->sq,
+			     sizeof(ic->sq), 0);
+	if (ret)
+		return ret;
+	mutex_lock(&ic->lock);
+	dev_info(ic->dev,
+		 "WLFW service arrival in state %s (connected=%u busy=%u)\n",
+		 icnss_recovery_state_name(ic->recovery_state),
+		 ic->qmi_connected, work_busy(&ic->server_work));
+	ic->qmi_connected = true;
+	/* Duplicate service discovery must not regress completed server_work. */
+	if (ic->recovery_state != ICNSS_RECOVERY_RECOVERING &&
+	    ic->recovery_state != ICNSS_RECOVERY_FW_READY &&
+	    ic->recovery_state != ICNSS_RECOVERY_READY)
+		ic->recovery_state = ICNSS_RECOVERY_INITIALIZING;
+	ic->last_error = 0;
+	mutex_unlock(&ic->lock);
+	queue_work(ic->wq, &ic->server_work);
+	return 0;
+}
+
+static void icnss_qmi_del_server(struct qmi_handle *qmi,
+				 struct qmi_service *service)
+{
+	struct icnss_clover *ic =
+		container_of(qmi, struct icnss_clover, qmi);
+
+	if (!ic->removing)
+		queue_work(ic->wq, &ic->server_exit_work);
+}
+
+static const struct qmi_ops icnss_qmi_ops = {
+	.new_server = icnss_qmi_new_server,
+	.del_server = icnss_qmi_del_server,
+};
+
+int __icnss_register_driver(struct icnss_driver_ops *ops,
+			    struct module *owner, const char *mod_name)
+{
+	struct icnss_clover *ic = icnss_from_dev(NULL);
+	bool ready;
+
+	if (!ic)
+		return -EPROBE_DEFER;
+	if (!ops || !ops->probe || !owner || !mod_name)
+		return -EINVAL;
+	mutex_lock(&ic->lock);
+	if (ic->ops) {
+		mutex_unlock(&ic->lock);
+		return -EBUSY;
+	}
+	ic->ops = ops;
+	ready = ic->fw_ready;
+	mutex_unlock(&ic->lock);
+	if (ready)
+		icnss_call_fw_ready(ic);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(__icnss_register_driver);
+
+int icnss_unregister_driver(struct icnss_driver_ops *ops)
+{
+	struct icnss_clover *ic = icnss_from_dev(NULL);
+	bool remove;
+
+	if (!ic)
+		return -ENODEV;
+	mutex_lock(&ic->lock);
+	if (ic->ops != ops) {
+		mutex_unlock(&ic->lock);
+		return -ENOENT;
+	}
+	remove = ic->driver_probed;
+	ic->ops = NULL;
+	ic->active_ops = NULL;
+	ic->driver_probed = false;
+	ic->recovering = false;
+	ic->recovery_state = ic->fw_ready ? ICNSS_RECOVERY_FW_READY :
+		ICNSS_RECOVERY_INACTIVE;
+	mutex_unlock(&ic->lock);
+	if (remove && ops->remove)
+		ops->remove(ic->dev);
+	icnss_hw_power_off(ic);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(icnss_unregister_driver);

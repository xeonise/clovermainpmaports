+static int icnss_qmi_cfg(struct icnss_clover *ic,
+			 struct icnss_wlan_enable_cfg *config,
+			 const char *host_version)
+{
+	struct wlfw_wlan_cfg_resp_msg_v01 resp = {};
+	struct wlfw_wlan_cfg_req_msg_v01 *req;
+	struct qmi_txn txn;
+	u32 i;
+	int ret;
+
+	if (!config || !config->ce_tgt_cfg || !config->ce_svc_cfg)
+		return -EINVAL;
+	req = kzalloc(sizeof(*req), GFP_KERNEL);
+	if (!req)
+		return -ENOMEM;
+
+	if (host_version) {
+		req->host_version_valid = 1;
+		strscpy(req->host_version, host_version,
+			sizeof(req->host_version));
+	}
+	req->tgt_cfg_valid = 1;
+	req->tgt_cfg_len = min_t(u32, config->num_ce_tgt_cfg,
+				 QMI_WLFW_MAX_NUM_CE_V01);
+	for (i = 0; i < req->tgt_cfg_len; i++) {
+		req->tgt_cfg[i].pipe_num = config->ce_tgt_cfg[i].pipe_num;
+		req->tgt_cfg[i].pipe_dir = config->ce_tgt_cfg[i].pipe_dir;
+		req->tgt_cfg[i].nentries = config->ce_tgt_cfg[i].nentries;
+		req->tgt_cfg[i].nbytes_max = config->ce_tgt_cfg[i].nbytes_max;
+		req->tgt_cfg[i].flags = config->ce_tgt_cfg[i].flags;
+	}
+	req->svc_cfg_valid = 1;
+	req->svc_cfg_len = min_t(u32, config->num_ce_svc_pipe_cfg,
+				 QMI_WLFW_MAX_NUM_SVC_V01);
+	for (i = 0; i < req->svc_cfg_len; i++) {
+		req->svc_cfg[i].service_id = config->ce_svc_cfg[i].service_id;
+		req->svc_cfg[i].pipe_dir = config->ce_svc_cfg[i].pipe_dir;
+		req->svc_cfg[i].pipe_num = config->ce_svc_cfg[i].pipe_num;
+	}
+	req->shadow_reg_valid = 1;
+	req->shadow_reg_len = min_t(u32, config->num_shadow_reg_cfg,
+				    QMI_WLFW_MAX_NUM_SHADOW_REG_V01);
+	for (i = 0; i < req->shadow_reg_len; i++) {
+		req->shadow_reg[i].id = config->shadow_reg_cfg[i].ce_id;
+		req->shadow_reg[i].offset =
+			config->shadow_reg_cfg[i].reg_offset;
+	}
+
+	ret = qmi_txn_init(&ic->qmi, &txn,
+			   wlfw_wlan_cfg_resp_msg_v01_ei, &resp);
+	if (ret < 0)
+		goto out;
+	ret = qmi_send_request(&ic->qmi, NULL, &txn,
+			       QMI_WLFW_WLAN_CFG_REQ_V01,
+			       WLFW_WLAN_CFG_REQ_MSG_V01_MAX_MSG_LEN,
+			       wlfw_wlan_cfg_req_msg_v01_ei, req);
+	if (ret) {
+		qmi_txn_cancel(&txn);
+		goto out;
+	}
+	ret = qmi_txn_wait(&txn, ICNSS_WLFW_TIMEOUT * HZ);
+	if (ret >= 0)
+		ret = icnss_qmi_result(ic, "wlan-cfg", &resp.resp);
+out:
+	kfree(req);
+	return ret;
+}

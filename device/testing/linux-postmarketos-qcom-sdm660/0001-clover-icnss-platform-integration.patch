+static int icnss_clover_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct icnss_clover *ic;
+	struct resource r;
+	int i;
+	int ret;
+
+	ic = devm_kzalloc(dev, sizeof(*ic), GFP_KERNEL);
+	if (!ic)
+		return -ENOMEM;
+	ic->dev = dev;
+	mutex_init(&ic->lock);
+	platform_set_drvdata(pdev, ic);
+
+	/*
+	 * qcacld's WCN3990 HTT fragment descriptors carry only the low
+	 * 32 address bits.  A wider mask lets DMA-IOMMU hand out IOVAs that
+	 * firmware subsequently truncates, causing an unmapped access.
+	 */
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+	ic->mem_base = devm_platform_ioremap_resource_byname(pdev, "membase");
+	if (IS_ERR(ic->mem_base))
+		return PTR_ERR(ic->mem_base);
+	ic->mem_base_pa =
+		platform_get_resource_byname(pdev, IORESOURCE_MEM, "membase")->start;
+	ic->soc.v_addr = ic->mem_base;
+	ic->soc.p_addr = ic->mem_base_pa;
+
+	for (i = 0; i < ARRAY_SIZE(ic->ce); i++) {
+		ret = icnss_clover_get_irq(pdev, i);
+		if (ret < 0)
+			return ret;
+		ic->ce[i].irq = ret;
+	}
+	for (i = 0; i < ARRAY_SIZE(ic->vregs); i++)
+		ic->vregs[i].supply = icnss_vreg_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ic->vregs), ic->vregs);
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(ic->clks); i++)
+		ic->clks[i].id = icnss_clk_names[i];
+	ret = devm_clk_bulk_get_optional(dev, ARRAY_SIZE(ic->clks), ic->clks);
+	if (ret)
+		return ret;
+
+	ret = of_reserved_mem_region_to_resource(dev->of_node, 0, &r);
+	if (!ret) {
+		ic->msa_pa = r.start;
+		ic->msa_size = resource_size(&r);
+		ic->msa_va = devm_memremap(dev, r.start, resource_size(&r),
+					   MEMREMAP_WT);
+		if (IS_ERR(ic->msa_va))
+			return PTR_ERR(ic->msa_va);
+	} else {
+		ic->msa_size = ICNSS_MSA_SIZE;
+		ic->msa_va = dmam_alloc_coherent(dev, ic->msa_size,
+						 &ic->msa_pa, GFP_KERNEL);
+		if (!ic->msa_va)
+			return -ENOMEM;
+	}
+	ic->msa_fixed_perm =
+		device_property_read_bool(dev, "qcom,msa-fixed-perm");
+	device_get_mac_address(dev, (char *)ic->mac_addr);
+
+	ic->wq = alloc_ordered_workqueue("icnss_clover", WQ_MEM_RECLAIM);
+	if (!ic->wq)
+		return -ENOMEM;
+	INIT_WORK(&ic->server_work, icnss_server_work);
+	INIT_WORK(&ic->bdf_work, icnss_bdf_work);
+	INIT_WORK(&ic->fw_ready_work, icnss_fw_ready_work);
+	INIT_WORK(&ic->server_exit_work, icnss_server_exit_work);
+	ret = qmi_handle_init(&ic->qmi,
+			      WLFW_BDF_DOWNLOAD_REQ_MSG_V01_MAX_MSG_LEN,
+			      &icnss_qmi_ops, icnss_qmi_handlers);
+	if (ret)
+		goto err_wq;
+	ic->qmi_initialized = true;
+	ret = qmi_add_lookup(&ic->qmi, WLFW_SERVICE_ID_V01,
+			     WLFW_SERVICE_VERS_V01, 0);
+	if (ret)
+		goto err_qmi;
+
+	mutex_lock(&icnss_global_lock);
+	if (icnss_global) {
+		mutex_unlock(&icnss_global_lock);
+		ret = -EBUSY;
+		goto err_qmi;
+	}
+	icnss_global = ic;
+	mutex_unlock(&icnss_global_lock);
+	dev_info(dev, "WCN3990 ICNSS/WLFW backend registered\n");
+	return 0;
+
+err_qmi:
+	qmi_handle_release(&ic->qmi);
+	ic->qmi_initialized = false;
+err_wq:
+	destroy_workqueue(ic->wq);
+	return ret;
+}
+
+static void icnss_clover_remove(struct platform_device *pdev)
+{
+	struct icnss_clover *ic = platform_get_drvdata(pdev);
+	int i;
+
+	mutex_lock(&ic->lock);
+	ic->removing = true;
+	mutex_unlock(&ic->lock);
+	mutex_lock(&icnss_global_lock);
+	if (icnss_global == ic)
+		icnss_global = NULL;
+	mutex_unlock(&icnss_global_lock);
+	if (ic->qmi_initialized)
+		qmi_handle_release(&ic->qmi);
+	cancel_work_sync(&ic->server_work);
+	cancel_work_sync(&ic->bdf_work);
+	cancel_work_sync(&ic->fw_ready_work);
+	cancel_work_sync(&ic->server_exit_work);
+	if (ic->driver_probed && ic->active_ops && ic->active_ops->remove)
+		ic->active_ops->remove(ic->dev);
+	for (i = 0; i < ARRAY_SIZE(ic->ce); i++)
+		if (ic->ce[i].requested)
+			free_irq(ic->ce[i].irq, ic->ce[i].ctx);
+	icnss_unassign_msa(ic);
+	icnss_hw_power_off(ic);
+	kfree(ic->dfs_nol);
+	destroy_workqueue(ic->wq);
+}
+
+static void icnss_clover_shutdown(struct platform_device *pdev)
+{
+	struct icnss_clover *ic = platform_get_drvdata(pdev);
+	struct icnss_driver_ops *ops;
+
+	mutex_lock(&ic->lock);
+	ops = ic->driver_probed ? ic->active_ops : NULL;
+	mutex_unlock(&ic->lock);
+	if (ops && ops->shutdown)
+		ops->shutdown(ic->dev);
+	icnss_hw_power_off(ic);
+}
+
+static int icnss_clover_pm_suspend(struct device *dev)

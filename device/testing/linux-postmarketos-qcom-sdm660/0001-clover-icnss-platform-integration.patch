+int icnss_ce_request_irq(struct device *dev, unsigned int ce_id,
+			 irqreturn_t (*handler)(int, void *), unsigned long flags,
+			 const char *name, void *ctx)
+{
+	struct icnss_clover *ic = icnss_from_dev(dev);
+	int ret;
+
+	if (!ic || ce_id >= ARRAY_SIZE(ic->ce) || !handler)
+		return -EINVAL;
+	mutex_lock(&ic->lock);
+	if (ic->ce[ce_id].requested) {
+		mutex_unlock(&ic->lock);
+		return -EEXIST;
+	}
+	ret = request_irq(ic->ce[ce_id].irq, handler, flags, name, ctx);
+	if (!ret) {
+		ic->ce[ce_id].ctx = ctx;
+		ic->ce[ce_id].requested = true;
+	}
+	mutex_unlock(&ic->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(icnss_ce_request_irq);
+
+int icnss_ce_free_irq(struct device *dev, unsigned int ce_id, void *ctx)
+{
+	struct icnss_clover *ic = icnss_from_dev(dev);
+
+	if (!ic || ce_id >= ARRAY_SIZE(ic->ce))
+		return -EINVAL;
+	mutex_lock(&ic->lock);
+	if (!ic->ce[ce_id].requested || ic->ce[ce_id].ctx != ctx) {
+		mutex_unlock(&ic->lock);
+		return -ENOENT;
+	}
+	free_irq(ic->ce[ce_id].irq, ctx);
+	ic->ce[ce_id].requested = false;
+	ic->ce[ce_id].ctx = NULL;
+	mutex_unlock(&ic->lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(icnss_ce_free_irq);
+
+void icnss_enable_irq(struct device *dev, unsigned int ce_id)
+{
+	struct icnss_clover *ic = icnss_from_dev(dev);
+
+	if (ic && ce_id < ARRAY_SIZE(ic->ce))
+		enable_irq(ic->ce[ce_id].irq);
+}
+EXPORT_SYMBOL_GPL(icnss_enable_irq);
+
+void icnss_disable_irq(struct device *dev, unsigned int ce_id)
+{
+	struct icnss_clover *ic = icnss_from_dev(dev);
+
+	if (ic && ce_id < ARRAY_SIZE(ic->ce))
+		disable_irq(ic->ce[ce_id].irq);
+}
+EXPORT_SYMBOL_GPL(icnss_disable_irq);

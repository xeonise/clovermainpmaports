+
+int icnss_smmu_map(struct device *dev, phys_addr_t paddr, u32 *iova_addr,
+		   size_t size)
+{
+	dma_addr_t dma;
+
+	if (!dev || !iova_addr)
+		return -EINVAL;
+	dma = dma_map_resource(dev, paddr, size, DMA_BIDIRECTIONAL, 0);
+	if (dma_mapping_error(dev, dma))
+		return -EIO;
+	if (upper_32_bits(dma))
+		dma_unmap_resource(dev, dma, size, DMA_BIDIRECTIONAL, 0);
+	if (upper_32_bits(dma))
+		return -ERANGE;
+	*iova_addr = lower_32_bits(dma);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(icnss_smmu_map);

+int icnss_wlan_set_dfs_nol(const void *info, u16 len)
+{
+	struct icnss_clover *ic = icnss_from_dev(NULL);
+	void *copy;
+
+	if (!ic || (len && !info))
+		return -EINVAL;
+	copy = len ? kmemdup(info, len, GFP_KERNEL) : NULL;
+	if (len && !copy)
+		return -ENOMEM;
+	mutex_lock(&ic->lock);
+	kfree(ic->dfs_nol);
+	ic->dfs_nol = copy;
+	ic->dfs_nol_len = len;
+	mutex_unlock(&ic->lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(icnss_wlan_set_dfs_nol);
+
+int icnss_wlan_get_dfs_nol(void *info, u16 len)
+{
+	struct icnss_clover *ic = icnss_from_dev(NULL);
+
+	if (!ic || !info)
+		return -EINVAL;
+	mutex_lock(&ic->lock);
+	if (len < ic->dfs_nol_len) {
+		mutex_unlock(&ic->lock);
+		return -ENOSPC;
+	}
+	memcpy(info, ic->dfs_nol, ic->dfs_nol_len);
+	mutex_unlock(&ic->lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(icnss_wlan_get_dfs_nol);

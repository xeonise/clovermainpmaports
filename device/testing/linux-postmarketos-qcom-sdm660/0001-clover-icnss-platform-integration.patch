+static int icnss_clover_get_irq(struct platform_device *pdev,
+				unsigned int index)
+{
+	struct of_phandle_args oirq;
+	struct irq_domain *domain;
+	irq_hw_number_t hwirq;
+	unsigned int type;
+	unsigned int irq;
+	int ret;
+
+	ret = platform_get_irq(pdev, index);
+	if (ret != -ENXIO)
+		return ret;
+
+	/*
+	 * A live driver handoff can leave the existing GIC mappings intact
+	 * after the platform IRQ resource array has been released.  Recover
+	 * those mappings from the immutable OF interrupt specifiers.
+	 */
+	ret = of_irq_parse_one(pdev->dev.of_node, index, &oirq);
+	if (ret)
+		return ret;
+	domain = irq_find_host(oirq.np);
+	if (!domain) {
+		ret = -EPROBE_DEFER;
+		goto out_put;
+	}
+	if (!domain->ops->xlate) {
+		ret = -EOPNOTSUPP;
+		goto out_put;
+	}
+	ret = domain->ops->xlate(domain, oirq.np, oirq.args,
+				 oirq.args_count, &hwirq, &type);
+	if (ret)
+		goto out_put;
+	irq = irq_find_mapping(domain, hwirq);
+	if (!irq) {
+		ret = -ENXIO;
+		goto out_put;
+	}
+	irq_set_irq_type(irq, type);
+	ret = irq;
+
+out_put:
+	of_node_put(oirq.np);
+	return ret;
+}

+int icnss_athdiag_read(struct device *dev, u32 offset, u32 mem_type,
+		       u32 data_len, u8 *output)
+{
+	struct wlfw_athdiag_read_req_msg_v01 req = {
+		.offset = offset,
+		.mem_type = mem_type,
+		.data_len = data_len,
+	};
+	struct wlfw_athdiag_read_resp_msg_v01 *resp;
+	struct icnss_clover *ic = icnss_from_dev(dev);
+	struct qmi_txn txn;
+	int ret;
+
+	if (!ic)
+		return -ENODEV;
+	if (!output || !data_len ||
+	    data_len > QMI_WLFW_MAX_ATHDIAG_DATA_SIZE_V01)
+		return -EINVAL;
+	mutex_lock(&ic->lock);
+	ret = ic->qmi_connected && ic->fw_ready && ic->powered ?
+		0 : -ENETDOWN;
+	mutex_unlock(&ic->lock);
+	if (ret)
+		return ret;
+	resp = kzalloc(sizeof(*resp), GFP_KERNEL);
+	if (!resp)
+		return -ENOMEM;
+	ret = qmi_txn_init(&ic->qmi, &txn,
+			   wlfw_athdiag_read_resp_msg_v01_ei, resp);
+	if (ret < 0)
+		goto out;
+	ret = qmi_send_request(&ic->qmi, NULL, &txn,
+			       QMI_WLFW_ATHDIAG_READ_REQ_V01,
+			       WLFW_ATHDIAG_READ_REQ_MSG_V01_MAX_MSG_LEN,
+			       wlfw_athdiag_read_req_msg_v01_ei, &req);
+	if (ret) {
+		qmi_txn_cancel(&txn);
+		goto out;
+	}
+	ret = qmi_txn_wait(&txn, ICNSS_WLFW_TIMEOUT * HZ);
+	if (ret >= 0)
+		ret = icnss_result_to_errno(&resp->resp);
+	if (!ret && (!resp->data_valid || resp->data_len < data_len))
+		ret = -EMSGSIZE;
+	if (!ret)
+		memcpy(output, resp->data, data_len);
+out:
+	kfree(resp);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(icnss_athdiag_read);
+
+int icnss_athdiag_write(struct device *dev, u32 offset, u32 mem_type,
+			u32 data_len, u8 *input)
+{
+	struct wlfw_athdiag_write_req_msg_v01 *req;
+	struct wlfw_athdiag_write_resp_msg_v01 resp = {};
+	struct icnss_clover *ic = icnss_from_dev(dev);
+	struct qmi_txn txn;
+	int ret;
+
+	if (!ic)
+		return -ENODEV;
+	if (!input || !data_len ||
+	    data_len > QMI_WLFW_MAX_ATHDIAG_DATA_SIZE_V01)
+		return -EINVAL;
+	mutex_lock(&ic->lock);
+	ret = ic->qmi_connected && ic->fw_ready && ic->powered ?
+		0 : -ENETDOWN;
+	mutex_unlock(&ic->lock);
+	if (ret)
+		return ret;
+	req = kzalloc(sizeof(*req), GFP_KERNEL);
+	if (!req)
+		return -ENOMEM;
+	req->offset = offset;
+	req->mem_type = mem_type;
+	req->data_len = data_len;
+	memcpy(req->data, input, data_len);
+	ret = qmi_txn_init(&ic->qmi, &txn,
+			   wlfw_athdiag_write_resp_msg_v01_ei, &resp);
+	if (ret < 0)
+		goto out;
+	ret = qmi_send_request(&ic->qmi, NULL, &txn,
+			       QMI_WLFW_ATHDIAG_WRITE_REQ_V01,
+			       WLFW_ATHDIAG_WRITE_REQ_MSG_V01_MAX_MSG_LEN,
+			       wlfw_athdiag_write_req_msg_v01_ei, req);
+	if (ret) {
+		qmi_txn_cancel(&txn);
+		goto out;
+	}
+	ret = qmi_txn_wait(&txn, ICNSS_WLFW_TIMEOUT * HZ);
+	if (ret >= 0)
+		ret = icnss_result_to_errno(&resp.resp);
+out:
+	kfree(req);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(icnss_athdiag_write);

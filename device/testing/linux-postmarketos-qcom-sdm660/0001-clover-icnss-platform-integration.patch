+int icnss_trigger_recovery(struct device *dev)
+{
+	struct icnss_clover *ic = icnss_from_dev(dev);
+	struct icnss_driver_ops *ops;
+
+	if (!ic)
+		return -ENODEV;
+	mutex_lock(&ic->lock);
+	ops = ic->active_ops;
+	ic->recovering = ic->driver_probed;
+	if (ic->recovering)
+		icnss_begin_recovery_locked(ic);
+	mutex_unlock(&ic->lock);
+	if (ops && ops->crash_shutdown)
+		ops->crash_shutdown(ic->dev);
+	return icnss_qmi_mode(ic, QMI_WLFW_OFF_V01);
+}
+EXPORT_SYMBOL_GPL(icnss_trigger_recovery);

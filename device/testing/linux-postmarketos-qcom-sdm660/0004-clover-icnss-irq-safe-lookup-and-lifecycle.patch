+/*
+ * WLFW runs on the modem.  WLFW del_server only arrives after the modem is
+ * already being stopped, and qcacld keeps touching CE registers until it
+ * sees FW_DOWN.  Report it from the modem SSR notifier before shutdown so
+ * qcacld stops register access while WCSS is still clocked.
+ */
+static int icnss_ssr_notify(struct notifier_block *nb, unsigned long action,
+			    void *data)
+{
+	struct icnss_clover *ic =
+		container_of(nb, struct icnss_clover, ssr_nb);
+	const struct qcom_ssr_notify_data *notify = data;
+	struct icnss_uevent_fw_down_data down = {
+		.crashed = notify && notify->crashed,
+	};
+	struct icnss_uevent_data event = {
+		.uevent = ICNSS_UEVENT_FW_DOWN,
+		.data = &down,
+	};
+	struct icnss_driver_ops *ops = NULL;
+
+	if (action != QCOM_SSR_BEFORE_SHUTDOWN)
+		return NOTIFY_DONE;
+
+	guard(mutex)(&ic->client_lock);
+	mutex_lock(&ic->lock);
+	if (!ic->removing && ic->driver_probed && !ic->fw_down_sent) {
+		ops = ic->active_ops;
+		ic->fw_down_sent = true;
+	}
+	mutex_unlock(&ic->lock);
+	if (ops && ops->uevent) {
+		dev_info(ic->dev, "modem shutting down, reporting WLFW down\n");
+		ops->uevent(ic->dev, &event);
+	}
+
+	return NOTIFY_OK;
+}

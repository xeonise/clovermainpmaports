# Kernel config based on: arch/arm64/configs/sdm660_defconfig
maintainer="Alexey Minnekhanov <alexeymin@postmarketos.org>"
_flavor="postmarketos-qcom-sdm660"
pkgname=linux-$_flavor
pkgver=6.19.10
pkgrel=7
pkgdesc="Mainline kernel fork for Qualcomm SDM660 devices"
arch="aarch64"
_carch="arm64"
url="https://github.com/sdm660-mainline/linux"
license="GPL-2.0-only"
makedepends="
	bash
	bc
	bison
	devicepkg-dev
	findutils
	flex
	installkernel
	kmod
	openssl-dev
	perl
	python3
	samurai
	zstd
	"
options="!strip !check !tracedeps pmb:cross-native"

# Source
_tag="v${pkgver}-sdm660"
_config="config-$_flavor.$arch"
_xiaomi_wlan_commit="728ac0be7512264ecdc3bf885a19c581c6890c17"
source="
	linux-$_tag.tar.gz::https://github.com/sdm660-mainline/linux/archive/refs/tags/$_tag.tar.gz
	$_config
	xiaomi-wlan-$_xiaomi_wlan_commit.tar.gz::https://github.com/MiCode/vendor_qcom_opensource_wlan/archive/$_xiaomi_wlan_commit.tar.gz
	0001-clover-icnss-platform-integration.patch
	0002-xiaomi-qcacld-linux-6.19-port.patch
	0003-clover-usb-otg.patch
	0004-clover-icnss-irq-safe-lookup-and-lifecycle.patch
	0005-qcacld-dump-station-report-bssid.patch
	0006-qcacld-production-assertions-and-build-checks.patch
"
# The archive directory omits the leading v from the tag.
builddir="$srcdir/linux-$pkgver-sdm660"
_outdir="out"

prepare() {
	# This vendor tree tracks a generated top-level .config. Remove it before
	# out-of-tree builds; otherwise Kbuild aborts with "source tree is not clean".
	rm -f .config

	# Keep Xiaomi's matched 5.2 WLAN components as normal kernel sources.
	# The Clover device package selects QCACLD at boot.
	test ! -e "$builddir/drivers/staging/qcacld-3.0" || return 1
	test ! -e "$builddir/drivers/staging/qca-wifi-host-cmn" || return 1
	test ! -e "$builddir/drivers/staging/fw-api" || return 1
	mkdir -p "$builddir/drivers/staging/qcacld-3.0" \
		"$builddir/drivers/staging/qca-wifi-host-cmn" \
		"$builddir/drivers/staging/fw-api"
	local xiaomi_wlan="$srcdir/vendor_qcom_opensource_wlan-$_xiaomi_wlan_commit"
	cp -a "$xiaomi_wlan/qcacld-3.0/." \
		"$builddir/drivers/staging/qcacld-3.0/"
	cp -a "$xiaomi_wlan/qca-wifi-host-cmn/." \
		"$builddir/drivers/staging/qca-wifi-host-cmn/"
	cp -a "$xiaomi_wlan/fw-api/." \
		"$builddir/drivers/staging/fw-api/"
	default_prepare

	mkdir -p "$_outdir"
	cp "$srcdir/$_config" "$_outdir/.config"
}

build() {
	unset LDFLAGS
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$arch" \
		CFLAGS_MODULE=-fno-pic \
		DTC_FLAGS="-@"
}

package() {
	mkdir -p "$pkgdir"/boot
	make O="$_outdir" ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		modules_install dtbs_install

	install -Dm644 "$builddir/$_outdir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"

	local image
	image="$(find "$builddir" -type f -path '*/arch/arm64/boot/Image.gz' -print -quit)"
	if [ -z "$image" ]; then
		image="$(find "$builddir" -type f -path '*/arch/arm64/boot/Image' -print -quit)"
		[ -n "$image" ] || return 1
		gzip -c "$image" > "$pkgdir/boot/vmlinuz-$_flavor"
	else
		install -Dm644 "$image" "$pkgdir/boot/vmlinuz-$_flavor"
	fi
	install -Dm644 "$srcdir/$_config" \
		"$pkgdir/boot/config-$_flavor"
	install -Dm644 "$(find "$builddir" -type f -name System.map -print -quit)" \
		"$pkgdir/boot/System.map-$_flavor"
}


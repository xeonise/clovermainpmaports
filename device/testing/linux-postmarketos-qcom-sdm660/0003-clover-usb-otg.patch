diff --git a/drivers/power/supply/qcom_smbx.c b/drivers/power/supply/qcom_smbx.c
index 78de881..f13d5b8 100644
--- a/drivers/power/supply/qcom_smbx.c
+++ b/drivers/power/supply/qcom_smbx.c
@@ -12,0 +13 @@
+#include <linux/iopoll.h>
@@ -22,0 +24 @@
+#include <linux/regulator/driver.h>
@@ -103,0 +106,12 @@
+#define OTG_STATUS					0x109
+#define BOOST_SOFTSTART_DONE_BIT			BIT(3)
+
+#define CMD_OTG						0x140
+#define OTG_EN_BIT					BIT(0)
+
+#define OTG_CURRENT_LIMIT_CFG				0x152
+#define OTG_CURRENT_LIMIT_MASK				GENMASK(2, 0)
+#define OTG_CURRENT_STEP_UA				250000
+#define OTG_CURRENT_MAX_UA				2000000
+#define OTG_DEFAULT_CURRENT_UA				1500000
+
@@ -386,0 +401,2 @@ struct smb_init_register {
+ * @vbus_rdev:		PM660 OTG boost regulator
+ * @usb_input_suspended: USB input state saved while sourcing VBUS
@@ -402,0 +419,2 @@ struct smb_chip {
+	struct regulator_dev *vbus_rdev;
+	bool usb_input_suspended;
@@ -788,0 +807,196 @@ static const struct power_supply_desc smb_psy_desc = {
+/* The PM660 OTG current selector advances in 250 mA steps. */
+static int smb_set_otg_current_limit(struct smb_chip *chip,
+				     int min_uA, int max_uA)
+{
+	unsigned int selector;
+	int current_uA;
+
+	if (min_uA <= 0 || min_uA > max_uA)
+		return -EINVAL;
+
+	selector = DIV_ROUND_UP(min_uA, OTG_CURRENT_STEP_UA) - 1;
+	current_uA = (selector + 1) * OTG_CURRENT_STEP_UA;
+	if (current_uA > max_uA || current_uA > OTG_CURRENT_MAX_UA)
+		return -EINVAL;
+
+	return regmap_update_bits(chip->regmap,
+				  chip->base + OTG_CURRENT_LIMIT_CFG,
+				  OTG_CURRENT_LIMIT_MASK, selector);
+}
+
+static int smb_vbus_set_current_limit(struct regulator_dev *rdev,
+				      int min_uA, int max_uA)
+{
+	return smb_set_otg_current_limit(rdev_get_drvdata(rdev),
+					 min_uA, max_uA);
+}
+
+static int smb_vbus_get_current_limit(struct regulator_dev *rdev)
+{
+	struct smb_chip *chip = rdev_get_drvdata(rdev);
+	unsigned int selector;
+	int rc;
+
+	rc = regmap_read(chip->regmap,
+			 chip->base + OTG_CURRENT_LIMIT_CFG, &selector);
+	if (rc < 0)
+		return rc;
+
+	selector &= OTG_CURRENT_LIMIT_MASK;
+	return (selector + 1) * OTG_CURRENT_STEP_UA;
+}
+
+static int smb_vbus_regulator_enable(struct regulator_dev *rdev)
+{
+	/* PM660 needs a low-current soft start before reaching the target limit. */
+	static const int startup_limits_uA[] = {
+		250000, 500000, 1000000, OTG_DEFAULT_CURRENT_UA,
+	};
+	struct smb_chip *chip = rdev_get_drvdata(rdev);
+	unsigned int input_cmd, status;
+	unsigned int i;
+	int rc;
+
+	/* Source VBUS only after suspending any USB input path. */
+	rc = regmap_read(chip->regmap, chip->base + USBIN_CMD_IL,
+			 &input_cmd);
+	if (rc < 0)
+		return rc;
+	chip->usb_input_suspended = input_cmd & USBIN_SUSPEND_BIT;
+
+	rc = regmap_update_bits(chip->regmap, chip->base + USBIN_CMD_IL,
+				USBIN_SUSPEND_BIT, USBIN_SUSPEND_BIT);
+	if (rc < 0)
+		return rc;
+
+	rc = regmap_update_bits(chip->regmap,
+				chip->base + OTG_ENG_OTG_CFG,
+				ENG_BUCKBOOST_HALT1_8_MODE_BIT,
+				ENG_BUCKBOOST_HALT1_8_MODE_BIT);
+	if (rc < 0)
+		goto restore_input;
+
+	for (i = 0; i < ARRAY_SIZE(startup_limits_uA); i++) {
+		rc = smb_set_otg_current_limit(chip, startup_limits_uA[i],
+					       startup_limits_uA[i]);
+		if (rc < 0)
+			goto disable_boost;
+
+		rc = regmap_update_bits(chip->regmap, chip->base + CMD_OTG,
+					OTG_EN_BIT, OTG_EN_BIT);
+		if (rc < 0)
+			goto disable_boost;
+
+		rc = regmap_read_poll_timeout(chip->regmap,
+					      chip->base + OTG_STATUS, status,
+					      status & BOOST_SOFTSTART_DONE_BIT,
+					      2000, 100000);
+		if (!rc)
+			break;
+		if (rc != -ETIMEDOUT)
+			goto disable_boost;
+
+		rc = regmap_update_bits(chip->regmap, chip->base + CMD_OTG,
+					OTG_EN_BIT, 0);
+		if (rc < 0)
+			goto disable_boost;
+	}
+	if (i == ARRAY_SIZE(startup_limits_uA)) {
+		rc = -ETIMEDOUT;
+		goto disable_boost;
+	}
+
+	rc = smb_set_otg_current_limit(chip, OTG_DEFAULT_CURRENT_UA,
+				       OTG_DEFAULT_CURRENT_UA);
+	if (!rc)
+		return 0;
+
+disable_boost:
+	regmap_update_bits(chip->regmap, chip->base + CMD_OTG, OTG_EN_BIT, 0);
+	regmap_update_bits(chip->regmap, chip->base + OTG_ENG_OTG_CFG,
+			   ENG_BUCKBOOST_HALT1_8_MODE_BIT, 0);
+restore_input:
+	if (!chip->usb_input_suspended)
+		regmap_update_bits(chip->regmap, chip->base + USBIN_CMD_IL,
+				   USBIN_SUSPEND_BIT, 0);
+
+	return rc;
+}
+
+static int smb_vbus_regulator_disable(struct regulator_dev *rdev)
+{
+	struct smb_chip *chip = rdev_get_drvdata(rdev);
+	int rc, ret;
+
+	rc = regmap_update_bits(chip->regmap, chip->base + CMD_OTG,
+				OTG_EN_BIT, 0);
+	ret = regmap_update_bits(chip->regmap, chip->base + OTG_ENG_OTG_CFG,
+				 ENG_BUCKBOOST_HALT1_8_MODE_BIT, 0);
+	if (!rc)
+		rc = ret;
+
+	if (!chip->usb_input_suspended) {
+		ret = regmap_update_bits(chip->regmap,
+					 chip->base + USBIN_CMD_IL,
+					 USBIN_SUSPEND_BIT, 0);
+		if (!rc)
+			rc = ret;
+	}
+
+	return rc;
+}
+
+static int smb_vbus_regulator_is_enabled(struct regulator_dev *rdev)
+{
+	struct smb_chip *chip = rdev_get_drvdata(rdev);
+	unsigned int value;
+	int rc;
+
+	rc = regmap_read(chip->regmap, chip->base + CMD_OTG, &value);
+	if (rc < 0)
+		return rc;
+
+	return !!(value & OTG_EN_BIT);
+}
+
+static const struct regulator_ops smb_vbus_regulator_ops = {
+	.enable = smb_vbus_regulator_enable,
+	.disable = smb_vbus_regulator_disable,
+	.is_enabled = smb_vbus_regulator_is_enabled,
+	.set_current_limit = smb_vbus_set_current_limit,
+	.get_current_limit = smb_vbus_get_current_limit,
+};
+
+static const struct regulator_desc smb_vbus_regulator_desc = {
+	.name = "pm660-usb-otg-vbus",
+	.of_match = "usb-vbus-regulator",
+	.type = REGULATOR_VOLTAGE,
+	.owner = THIS_MODULE,
+	.ops = &smb_vbus_regulator_ops,
+	.fixed_uV = 5000000,
+	.n_voltages = 1,
+};
+
+static int smb_init_vbus_regulator(struct smb_chip *chip)
+{
+	struct regulator_config config = {
+		.dev = chip->dev,
+		.driver_data = chip,
+		.regmap = chip->regmap,
+	};
+
+	/* Other SMB2 variants keep their existing regulator behaviour. */
+	if (!of_device_is_compatible(chip->dev->of_node,
+				     "qcom,pm660-charger"))
+		return 0;
+
+	chip->vbus_rdev = devm_regulator_register(chip->dev,
+						  &smb_vbus_regulator_desc,
+						  &config);
+	if (IS_ERR(chip->vbus_rdev))
+		return dev_err_probe(chip->dev, PTR_ERR(chip->vbus_rdev),
+				     "failed to register USB OTG VBUS regulator\n");
+
+	return 0;
+}
+
@@ -964,0 +1179,4 @@ static int smb_probe(struct platform_device *pdev)
+	rc = smb_init_vbus_regulator(chip);
+	if (rc < 0)
+		return rc;
+

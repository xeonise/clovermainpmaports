# If systemd is available, use unit activation.
ACTION=="add", SUBSYSTEM=="net", KERNEL=="wlan0", TEST=="/run/systemd/system", TAG+="systemd", ENV{SYSTEMD_WANTS}="xiaomi-clover-wlan-mac.service"

# Otherwise, run directly.
ACTION=="add", SUBSYSTEM=="net", KERNEL=="wlan0", TEST!="/run/systemd/system", RUN+="/usr/lib/device-xiaomi-clover/wifi-macaddr.sh"

#!/bin/sh

# Retained as a no-op so package upgrades replace the old dispatcher.
# A "down" event can be intentional (rfkill, suspend, driver handoff).
# Forcing wlan0 back up here races NetworkManager and can reset the target
# during teardown. Firmware recovery belongs to ICNSS/qcacld, not a shell
# job that survives the NetworkManager dispatcher.
exit 0

#!/bin/sh

IFACE="$1"
ACTION="$2"

[ "$IFACE" = "wlan0" ] || exit 0
[ "$ACTION" = "down" ] || exit 0
[ -e /run/xiaomi-clover-wlan-reset.lock ] && exit 0

(
	touch /run/xiaomi-clover-wlan-reset.lock
	sleep 1
	ip link set wlan0 down || true
	sleep 2
	ip link set wlan0 up || true
	rm -f /run/xiaomi-clover-wlan-reset.lock
) >/run/xiaomi-clover-wlan-reset.log 2>&1 &

exit 0

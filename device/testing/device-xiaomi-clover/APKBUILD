# Reference: <https://postmarketos.org/devicepkg>
maintainer=""
pkgname=device-xiaomi-clover
pkgdesc="Xiaomi Mi Pad 4"
pkgver=11
pkgrel=4
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	firmware-qcom-adreno-a530
	firmware-xiaomi-clover
	mkbootimg
	msm-firmware-loader
	postmarketos-base
	soc-qcom-sdm660
	soc-qcom-sdm660-rproc
"
makedepends="devicepkg-dev"
subpackages="
	$pkgname-kernel-clover:kernel_clover
	$pkgname-kernel-cloverplus:kernel_cloverplus
"
source="
	80-xiaomi-clover-wlan-mac.rules
	90-xiaomi-clover-crash.conf
	90-xiaomi-clover-journal.conf
	90-xiaomi-clover-wifi.conf
	90-xiaomi-clover-qcacld.conf
	90-xiaomi-clover-qcacld.modules
	WCNSS_qcom_cfg.ini
	clover-wifi-driver
	deviceinfo
	modules-initfs.clover
	modules-initfs.cloverplus
	wifi-macaddr.sh
	xiaomi-clover-wlan-mac.service
	xiaomi-clover-wlan-reset
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm755 "$srcdir"/wifi-macaddr.sh \
		-t "$pkgdir"/usr/lib/device-xiaomi-clover/

	install -Dm644 "$srcdir"/80-xiaomi-clover-wlan-mac.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d/

	install -Dm644 "$srcdir"/xiaomi-clover-wlan-mac.service \
		-t "$pkgdir"/usr/lib/systemd/system/

	install -Dm644 "$srcdir"/90-xiaomi-clover-wifi.conf \
		-t "$pkgdir"/usr/lib/NetworkManager/conf.d/
	install -Dm644 "$srcdir"/90-xiaomi-clover-crash.conf \
		-t "$pkgdir"/usr/lib/sysctl.d/
	install -Dm644 "$srcdir"/90-xiaomi-clover-journal.conf \
		-t "$pkgdir"/usr/lib/systemd/journald.conf.d/

	# QCACLD owns Clover's WCN3990 on every normal boot.  It must be selected
	# before module autoload, as ath10k_snoc and QCACLD cannot bind together.
	install -Dm644 "$srcdir"/90-xiaomi-clover-qcacld.conf \
		"$pkgdir"/etc/modprobe.d/90-xiaomi-clover-qcacld.conf
	install -Dm644 "$srcdir"/90-xiaomi-clover-qcacld.modules \
		"$pkgdir"/etc/modules-load.d/90-xiaomi-clover-qcacld.conf

	# Xiaomi SDM660 qcacld requests this exact firmware-class path.
	install -Dm644 "$srcdir"/WCNSS_qcom_cfg.ini \
		"$pkgdir"/lib/firmware/wlan/qca_cld/WCNSS_qcom_cfg.ini

	install -Dm755 "$srcdir"/clover-wifi-driver \
		"$pkgdir"/usr/sbin/clover-wifi-driver

	install -Dm755 "$srcdir"/xiaomi-clover-wlan-reset \
		-t "$pkgdir"/usr/lib/NetworkManager/dispatcher.d/

	# bootmac generates a stable but synthetic MAC from machine-id/serial.
	# Clover has the real factory WLAN MAC in persist, so disable only the
	# generic WLAN bootmac rule and keep Bluetooth handling untouched.
	mkdir -p "$pkgdir"/etc/udev/rules.d
	ln -s /dev/null "$pkgdir"/etc/udev/rules.d/90-bootmac-wifi.rules
}

kernel_clover() {
	pkgdesc="For regular Mi Pad 4"
	depends="linux-postmarketos-qcom-sdm660"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

kernel_cloverplus() {
	pkgdesc="For Mi Pad 4 Plus"
	depends="linux-postmarketos-qcom-sdm660"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

